---
import { Picture } from "astro:assets";
import heroBackground from "@/assets/hero_2.jpg";
---

<section class="relative w-full h-[80vh] overflow-hidden">
  <div class="hidden md:block">
    <Picture
      src={heroBackground}
      alt="Ciudad"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-center"
      loading="lazy"
      format="avif"
    />
  </div>
  <div class="block md:hidden">
    <Picture
      src={heroBackground}
      alt="Ciudad"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
      format="avif"
    />
  </div>

  <div class="absolute inset-0 bg-black/20"></div>
  <div class="relative z-10 max-w-7xl mx-auto h-full flex items-center justify-center px-4 lg:px-8">
    <div class="space-y-4">
      <h1 class="text-white text-center text-3xl md:text-4xl font-black">
        "VENGO AL CONGRESO...
      </h1>
       <h1 class="text-primary text-center text-4xl md:text-5xl font-bold leading-tight">
        A TRABAJAR DE VERDAD"
      </h1>
      <h2 class="text-white text-right text-2xl font-light uppercase md:text-3xl leading-tight">
        Fito Ráquel
      </h2>
      <div class="flex gap-4 mt-10 mb-20 justify-center">
        <a href="/propuestas" class="btn btn-accent md:btn-lg rounded-full" data-aos="fade-up">
          Ver Propuestas
        </a>
        <a href="#principios" class="btn btn-outline btn-accent md:btn-lg rounded-full" data-aos="fade-up">
          Conocé Más
        </a>
      </div>
    </div>
  </div>
</section>
