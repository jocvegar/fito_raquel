---
import { Picture } from "astro:assets";
import portrait from "@/assets/fito.jpg";
---

<section class="bg-blue-950 text-white">
  <div class="grid lg:min-h-[min(80vh,720px)] lg:grid-cols-2">
    <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto">
      <Picture
        src={portrait}
        alt="Fito Ráquel"
        widths={[640, 960, 1440, 1920]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[45%_25%]"
      />
    </div>

    <div class="flex max-w-2xl flex-col justify-center px-5 py-12 lg:px-16">
      <span class="h-1.5 w-14 rounded bg-accent" aria-hidden="true"></span>
      <h1 class="mt-6 text-4xl font-bold leading-tight md:text-6xl">
        Adolfo “Fito” Ráquel
      </h1>
      <p class="mt-4 text-lg text-blue-100 md:text-xl">
        Congreso Nacional de Honduras<br />
        Período 2026–2030
      </p>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-blue-100/90">
        Mi trabajo en el Congreso Nacional y en las comunidades.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/labor-legislativa/" class="btn btn-accent rounded-full md:btn-lg">
          Ver Labor Legislativa
        </a>
        <a href="#fito" class="btn btn-outline rounded-full border-white text-white hover:bg-white hover:text-blue-950 md:btn-lg">
          ¿Quién es Fito?
        </a>
      </div>
    </div>
  </div>
</section>
