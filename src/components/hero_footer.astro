---
import { Picture } from "astro:assets";
import background from "@/assets/hero_footer.jpeg";
import { entriesOf } from "@/lib/activity-data";

const hasGorraAzul = (await entriesOf("la-gorra-azul")).length > 0;
---

<section class="relative isolate overflow-hidden">
  <Picture
    src={background}
    alt="Multitud con una gran bandera de Honduras"
    widths={[640, 1024, 1920]}
    sizes="100vw"
    formats={["avif", "webp"]}
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-blue-950/75"></div>

  <div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-5 py-20 text-center text-white">
    <span class="h-1.5 w-14 rounded bg-accent" aria-hidden="true"></span>
    <h2 class="mt-6 text-3xl font-bold leading-tight md:text-5xl">
      Conozca el trabajo de Fito
    </h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/labor-legislativa/" class="btn btn-accent rounded-full md:btn-lg">
        Ver Labor Legislativa
      </a>
      {
        hasGorraAzul && (
          <a href="/la-gorra-azul/" class="btn btn-outline rounded-full border-white text-white hover:bg-white hover:text-blue-950 md:btn-lg">
            Ver La Gorra Azul
          </a>
        )
      }
    </div>
  </div>
</section>
