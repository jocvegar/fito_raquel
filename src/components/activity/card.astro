---
import { CATEGORIES, isoDate, formatDate, thumbnailOf } from "@/lib/activity";
import type { Entry } from "@/lib/activity-data";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { data } = entry;
const thumbnail = thumbnailOf(data);
---

<article
  class="group relative flex gap-4 rounded-lg border border-base-300 bg-white p-4 transition hover:border-primary/40 hover:shadow-md"
  data-category={data.category}>
  {
    thumbnail && (
      <div
        class:list={[
          "relative flex-shrink-0 overflow-hidden rounded-md bg-black",
          thumbnail.vertical ? "aspect-[9/16] w-20 sm:w-24" : "aspect-square w-24 sm:w-32",
        ]}>
        <img src={thumbnail.src} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        {data.video && (
          <span class="absolute bottom-1 right-1 rounded bg-black/70 px-1.5 py-0.5 text-xs text-white" aria-hidden="true">
            ▶ Video
          </span>
        )}
      </div>
    )
  }
  <div class="min-w-0">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <time datetime={isoDate(data.date)} class="font-semibold text-primary">
        {formatDate(data.date)}
      </time>
      <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
        {CATEGORIES[data.category]}
      </span>
    </p>
    <h3 class="mt-1 text-lg font-semibold leading-snug text-gray-900">
      <a href={entry.url} class="after:absolute after:inset-0 group-hover:text-primary">
        {data.title}
      </a>
    </h3>
    <p class="mt-1 line-clamp-3 text-gray-600">{data.summary}</p>
    {
      data.photos.length > 1 && (
        <p class="mt-2 text-sm text-gray-500">{data.photos.length} fotos</p>
      )
    }
  </div>
</article>
