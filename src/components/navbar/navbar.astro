---
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Image } from "astro:assets";
import logo from "@/assets/logo.png"
import { entriesOf } from "@/lib/activity-data";

const hasGorraAzul = (await entriesOf("la-gorra-azul")).length > 0;

const menuitems = [
   {
    title: "Inicio",
    path: "/",
  },
  {
    title: "Labor Legislativa",
    path: "/labor-legislativa/",
  },
  ...(hasGorraAzul
    ? [
        {
          title: "La Gorra Azul",
          path: "/la-gorra-azul/",
        },
      ]
    : []),
  {
    title: "¿Quién es Fito?",
    path: "/#fito",
  },
];
---

<header class="bg-blue-50 py-3">
  <Container class:list={['flex', 'flex-col', 'lg:flex-row', 'justify-between', 'items-center']}>
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-2xl md:text-4xl">
          <Image src={logo} alt="Fito Ráquel, inicio" width="120" height="120" />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="h-11 w-11 p-2.5 text-blue-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-2">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-primary hover:text-accent">
                      <span class="text-lg md:text-xl tracking-tight font-base">{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </MenuItems>
    </Astronav>
  </Container>
</header>
